// In Html multiline is not allowed, so new parser needed sadly
@precedence { math }

@top Program { expression* }

// Fallback rule for standard text (adjust to your host grammar)
expression { escapedChar | Dollar | Text 
	| DollarInlineMath
	| DollarDisplayMath
}

DollarInlineMath {
  InlineStart InlineMath? InlineEnd
}

DollarDisplayMath {
  DisplayStart DisplayMath? DisplayEnd
}

// Internal token for text inside the math block
@tokens {
  @precedence { escapedChar DisplayMath}
  @precedence { escapedChar InlineMath}
  @precedence { escapedChar Text }
  SpecialChar { $[\\$]}
  escapedChar { "\\" SpecialChar }
  DisplayMath { (escapedChar |![$])+ }
  InlineMath { (escapedChar |![$\n])+ }
  Text { (escapedChar |![$\n])+ }
}

@external tokens mathTokens from "./html-math_tokens" {
  InlineStart,
  InlineEnd,
  DisplayStart,
  DisplayEnd,
  Dollar
}
