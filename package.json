{
	"name": "obsidian-latex-suite",
	"version": "1.12.8",
	"description": "Make typesetting LaTeX math as fast as handwriting through snippets, text expansion, and editor enhancements",
	"main": "main.js",
	"types": "src/api.d.ts",
	"exports": {
		".": {
			"types": "./src/api.d.ts"
		}
	},
	"scripts": {
		"dev": "jiti esbuild.config.mts",
		"build": "tsc -noEmit -skipLibCheck && jiti esbuild.config.mts production",
		"version": "npm run lint && npm run build && jiti version-bump.mts && git add manifest.json versions.json",
		"lint": "tsc --noEmit -skipLibCheck && eslint",
		"tsc": "tsc --noEmit -skipLibCheck",
		"eslint": "eslint --fix",
		"generator": "npm run generator:latex",
		"generator:latex": "lezer-generator src/parser/mathjax/latex.grammar -o src/parser/mathjax/latex-parser",
		"postinstall": "npm run generator:latex",
		"test": "jiti esbuild.config.mts test & vitest"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/autocomplete": "^6.0.0",
		"@codemirror/commands": "^6.0.0",
		"@codemirror/lang-javascript": "^6.0.0",
		"@codemirror/language": "https://github.com/lishid/cm-language",
		"@codemirror/lint": "^6.0.0",
		"@codemirror/search": "^6.0.0",
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^9.39.2",
		"@lezer/common": "^1.0.3",
		"@lezer/generator": "^1.8.0",
		"@lezer/highlight": "^1.2.3",
		"@lezer/lr": "^1.4.10",
		"@types/node": "^22.20.1",
		"@typescript-eslint/eslint-plugin": "^8.55.0",
		"@typescript-eslint/parser": "^8.55.0",
		"codemirror": "^6.0.0",
		"esbuild": "^0.20.2",
		"esbuild-plugin-inline-import": "^1.0.2",
		"eslint": "^9.39.2",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.3.0",
		"i18next": "^26.4.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.13.1",
		"obsidian-integration-testing": "^10.3.2",
		"obsidian-typings": "^6.32.0",
		"remark-parse": "^11.0.0",
		"remark-stringify": "^11.0.0",
		"stylelint": "^17.14.1",
		"stylelint-config-obsidianmd": "^0.1.0",
		"tslib": "2.3.1",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@lezer/markdown": "^1.6.4",
		"@popperjs/core": "2.11.5",
		"valibot": "^1.4.2"
	}
}
