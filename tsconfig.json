{
  "compilerOptions": {
    "baseUrl": ".",
	"outDir": "dist",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
	"strictNullChecks": true,
    "moduleResolution": "node",
	"ignoreDeprecations": "6.0",
	"resolveJsonModule": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7",
      "ES2021.String"
    ],
	"types": [
		"node",
	]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
	"tests/**"
  ]
}
